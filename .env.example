# Alterra Environment Variables
# Copy to .env and fill in your values

# OpenRouter API Key (required)
# Get one at https://openrouter.ai/keys
ALTERRA_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override OpenRouter base URL
# ALTERRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Model selection (defaults to openrouter/free)
# ALTERRA_MODEL=openrouter/free

# Optional: Model parameters
# ALTERRA_TEMPERATURE=0.7
# ALTERRA_MAX_TOKENS=2048

# Optional: Disable provider fallbacks (default: false)
# ALTERRA_ALLOW_PROVIDER_FALLBACKS=false

# Voice configuration (Stage 3)
# Enable voice pipeline (default: false)
# ALTERRA_VOICE_ENABLED=false
# Audio sample rate (default: 16000)
# ALTERRA_VOICE_SAMPLE_RATE=16000
# Audio channels (default: 1)
# ALTERRA_VOICE_CHANNELS=1
# Input device index (default: system default)
# ALTERRA_VOICE_INPUT_DEVICE=0
# Output device index (default: system default)
# ALTERRA_VOICE_OUTPUT_DEVICE=0
# Wake word enabled (default: true)
# ALTERRA_VOICE_WAKE_WORD=true
# Wake word model (default: hey_jarvis)
# ALTERRA_VOICE_WAKE_WORD_MODEL=hey_jarvis
# Wake word threshold (default: 0.5)
# ALTERRA_VOICE_WAKE_WORD_THRESHOLD=0.5
# VAD threshold (default: 0.5)
# ALTERRA_VOICE_VAD_THRESHOLD=0.5
# VAD silence timeout in seconds (default: 1.0)
# ALTERRA_VOICE_VAD_SILENCE_TIMEOUT=1.0
# Max speech duration in seconds (default: 30.0)
# ALTERRA_VOICE_MAX_SPEECH_DURATION=30.0
# STT model size (default: base)
# ALTERRA_VOICE_STT_MODEL=base
# STT device (default: auto)
# ALTERRA_VOICE_STT_DEVICE=auto
# STT compute type (default: auto)
# ALTERRA_VOICE_STT_COMPUTE_TYPE=auto
# TTS voice (default: en_US-lessac-medium)
# ALTERRA_VOICE_TTS_VOICE=en_US-lessac-medium
# TTS model directory (default: ./models/tts/piper/)
# ALTERRA_VOICE_TTS_MODEL_DIR=
# TTS use CUDA (default: false)
# ALTERRA_VOICE_TTS_USE_CUDA=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
# ALTERRA_LOG_LEVEL=INFO

# Max tool rounds per conversation turn
# ALTERRA_MAX_TOOL_ROUNDS=8